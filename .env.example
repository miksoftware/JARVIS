# =============================================================================
# MIK-JARVIS Configuration Template (.env.example)
# Copia este archivo como .env y coloca tus propias credenciales.
# =============================================================================

# Enrutador / Servidor Remoto de IA (FreeLLMAPI - MIK Software)
# Endpoint OpenAI-compatible que requiere autenticación por API Key
FREELLMAPI_HOST=https://ai.miksoftwarecol.com
FREELLMAPI_API_KEY=tu_clave_freellmapi_aqui

# Fallback compatible con OpenAI
OPENAI_BASE_URL=https://ai.miksoftwarecol.com/v1
OPENAI_API_KEY=tu_clave_freellmapi_aqui

# Modelo por defecto (auto, gemini-3.5-flash-lite, gemma-4-31b-it, claude-sonnet-4-5, etc.)
OPENJARVIS_MODEL=auto

# Servidor OpenJarvis Estándar
OPENJARVIS_HOST=127.0.0.1
OPENJARVIS_PORT=8000

# Puerto Servidor Modo Iron Man (HUD Holográfico)
JARVIS_HUD_PORT=5000

# Configuración de ElevenLabs (Opcional - Voz ultra-realista "Sergio")
# Si se deja vacío, el sistema utiliza la síntesis de voz nativa local (SAPI5 en Windows)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=SHkfxEDcLXK31yPii5xM
